<?xml version="1.0" encoding="utf-8"?>
<!-- One list row, Android 12 and up: the same as layout/widget_row.xml except
     the tick box is a real CheckBox, which the launcher toggles and animates
     on its own the instant it is tapped. Keep the two in step. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:minHeight="44dp"
    android:orientation="horizontal"
    android:gravity="center_vertical"
    android:paddingTop="2dp"
    android:paddingBottom="2dp">

    <CheckBox
        android:id="@+id/row_check"
        android:layout_width="30dp"
        android:layout_height="30dp"
        android:minWidth="0dp"
        android:minHeight="0dp"
        android:button="@drawable/widget_check"
        android:background="@null"
        android:contentDescription="@string/widget_toggle_done" />

    <FrameLayout
        android:id="@+id/row_color"
        android:layout_width="3dp"
        android:layout_height="22dp"
        android:layout_marginEnd="12dp" />

    <LinearLayout
        android:id="@+id/row_body"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:orientation="vertical">

        <TextView
            android:id="@+id/row_title"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:fontFamily="sans-serif-medium"
            android:textSize="15sp"
            android:maxLines="1"
            android:ellipsize="end" />

        <TextView
            android:id="@+id/row_subtitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:fontFamily="sans-serif-medium"
            android:textSize="12sp"
            android:maxLines="1"
            android:ellipsize="end" />
    </LinearLayout>
</LinearLayout>
