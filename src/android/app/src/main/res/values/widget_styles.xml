<?xml version="1.0" encoding="utf-8"?>
<!-- Colours are set from Kotlin so the selected tab can change at runtime;
     these styles only carry the parts that never change. Sizes are the design
     canvas's. Full row height, so the whole strip is the tap target rather than
     just the glyphs. -->
<resources>
    <style name="WidgetTab">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">match_parent</item>
        <item name="android:layout_marginEnd">16dp</item>
        <item name="android:gravity">center_vertical</item>
        <item name="android:textSize">17sp</item>
        <item name="android:textStyle">bold</item>
    </style>

    <style name="WidgetTabSmall" parent="WidgetTab">
        <item name="android:layout_marginEnd">11dp</item>
        <item name="android:textSize">13sp</item>
    </style>

    <!-- The same two, tightened for the three-column layout -->
    <style name="WidgetTabCompact" parent="WidgetTab">
        <item name="android:layout_marginEnd">10dp</item>
        <item name="android:textSize">15sp</item>
    </style>

    <style name="WidgetTabSmallCompact" parent="WidgetTab">
        <item name="android:layout_marginEnd">7dp</item>
        <item name="android:textSize">12sp</item>
    </style>
</resources>
