<?xml version="1.0" encoding="utf-8"?>
<!-- The tick box on Android 12+, where RemoteViews allows a real CheckBox.
     The launcher flips the checked state itself the moment it is tapped, so
     these transitions play right away instead of waiting for the write. -->
<animated-selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item
        android:id="@+id/widget_checked"
        android:state_checked="true"
        android:drawable="@drawable/widget_check_on" />
    <item
        android:id="@+id/widget_unchecked"
        android:drawable="@drawable/widget_check_off" />

    <transition
        android:fromId="@id/widget_unchecked"
        android:toId="@id/widget_checked"
        android:drawable="@drawable/widget_check_anim_on" />
    <transition
        android:fromId="@id/widget_checked"
        android:toId="@id/widget_unchecked"
        android:drawable="@drawable/widget_check_anim_off" />
</animated-selector>
