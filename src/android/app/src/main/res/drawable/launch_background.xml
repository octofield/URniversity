<?xml version="1.0" encoding="utf-8"?>
<!-- The launch screen Android shows before Flutter's first frame. Kept in step
     with the app's own background so the hand-off is invisible; the app name is
     drawn by Flutter once it starts, because the Android 12 splash API cannot
     show text. -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:drawable="@color/splash_background" />

    <item
        android:drawable="@drawable/ic_launcher_foreground"
        android:gravity="center" />
</layer-list>
